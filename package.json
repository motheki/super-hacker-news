{
  "name": "super-hacker-news",
  "private": false,
  "packageManager": "bun@1.3.13",
  "homepage": "https://superhn.org",
  "bugs": "https://github.com/motheki/super-hacker-news/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/motheki/super-hacker-news.git"
  },
  "type": "module",
  "scripts": {
    "benchmark": "bun run build && bun run scripts/benchmark.ts",
    "benchmark:live": "bun run scripts/live-benchmark.ts",
    "brand:generate": "bun run scripts/generate-brand-assets.ts",
    "build": "bun run build:app",
    "build:app": "wrangler types --include-runtime false && astro check && astro build",
    "deploy": "bun run build:app && wrangler deploy",
    "dev": "wrangler types --include-runtime false && astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --config eslint.config.ts .",
    "lint:fix": "eslint --config eslint.config.ts --fix .",
    "preview": "astro preview",
    "start": "astro preview",
    "test": "bun test",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "wrangler types --include-runtime false && astro check && ./node_modules/@typescript/native/bin/tsc --noEmit --project tsconfig.native.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "astro": "7.3.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "0.35.4",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.129.0"
  }
}

{
  "name": "super-hacker-news",
  "private": false,
  "homepage": "https://superhn.vercel.app",
  "bugs": "https://github.com/motheki/super-hacker-news/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/motheki/super-hacker-news.git"
  },
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze --output",
    "prebuild": "bun -e \"import { rmSync } from 'node:fs'; rmSync('.next/dev', { recursive: true, force: true })\"",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:instant": "EXPOSE_TESTING_API=1 bun run build && playwright test --config playwright.instant.config.ts"
  },
  "dependencies": {
    "html-react-parser": "^6.1.7",
    "next": "16.4.0-canary.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@next/playwright": "16.4.0-canary.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}

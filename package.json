{
  "name": "super-hacker-news",
  "private": false,
  "homepage": "https://superhn.org",
  "bugs": "https://github.com/motheki/super-hacker-news/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/motheki/super-hacker-news.git"
  },
  "type": "module",
  "scripts": {
    "check": "node node_modules/astro/bin/astro.mjs check",
    "build": "node node_modules/astro/bin/astro.mjs build",
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "deploy": "bun run build && bun run deploy:assets",
    "deploy:assets": "node scripts/deploy.mjs",
    "test": "bun test",
    "validate": "bun run check && bun test && bun run build && bun run test:e2e",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config __tests_/playwright.config.ts",
    "deploy:dry-run": "node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "astro": "7.4.4",
    "astro-pagefind": "^2.0.1",
    "dompurify": "^3.4.17",
    "pagefind": "^1.5.2",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/sanitize-html": "^2.16.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "^4.155.0"
  }
}

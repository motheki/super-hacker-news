{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "super-hn",
  "workers_dev": true,
  "routes": [{ "pattern": "superhn.org", "custom_domain": true }],
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}

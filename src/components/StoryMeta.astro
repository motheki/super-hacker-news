---
interface Props {
  readonly points?: number | null;
  readonly user?: string | null;
  readonly timeAgo: string;
  readonly commentsCount: number;
  readonly commentsHref: string;
}

const { points, user, timeAgo, commentsCount, commentsHref } = Astro.props;
---

<div class="meta story-meta">
  <p class="story-stats">
    {points != null && <span>{points} points</span>}
    <span>{timeAgo}</span>
  </p>
  <div class="story-actions">
    <a
      class="meta-button comment-button"
      data-astro-prefetch={commentsHref.startsWith("#") ? undefined : "tap"}
      href={commentsHref}
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24">
        <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3h.5a8.5 8.5 0 0 1 8 8v.5Z" />
      </svg>
      <span>{commentsCount} {commentsCount === 1 ? "comment" : "comments"}</span>
    </a>
    {
      user != null && user.length > 0 && (
        <a
          class="meta-button poster-button"
          data-astro-prefetch="tap"
          href={`/user/${user}`}
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
          </svg>
          <span><span class="visually-hidden">Posted by </span>{user}</span>
        </a>
      )
    }
  </div>
</div>

---
import favicon32 from "~/assets/favicon-32.png";
import { TOPICS } from "~/lib/topic";

interface Props {
  readonly currentPath: string;
  readonly repositoryUrl: string;
}

const { currentPath, repositoryUrl } = Astro.props;
---

<header class="site-header">
  <a
    aria-label="Super HN home"
    class="brand"
    data-astro-prefetch="tap"
    href="/top"
  >
    <img alt="" height="34" src={favicon32.src} width="34" />
  </a>

  <nav aria-label="Topics" class="topic-nav">
    {
      TOPICS.map(({ name, title }) => {
        const active = currentPath === `/${name}`;

        return (
          <a
            aria-current={active ? "page" : undefined}
            class:list={["nav-link", { selected: active }]}
            data-astro-prefetch="tap"
            href={`/${name}`}
          >
            {title}
          </a>
        );
      })
    }
  </nav>

  <a
    aria-label="Project source code"
    class="source-link"
    href={repositoryUrl}
    rel="noreferrer noopener"
    title="Project source code"
  >
    <svg aria-hidden="true" height="22" viewBox="0 0 24 24" width="22">
      <path
        d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.3-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
      ></path>
    </svg>
  </a>
</header>

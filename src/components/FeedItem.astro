---
import StoryMeta from "~/components/StoryMeta.astro";
import { isSafeExternalUrl } from "~/lib/link";
import type { TopicItem } from "~/lib/topic";

interface Props {
  readonly index: number;
  readonly item: TopicItem;
}

const { index, item } = Astro.props;
const externalUrl = isSafeExternalUrl(item.url) ? item.url : null;
const storyUrl = externalUrl ?? `/post/${item.id}`;
---

<article class="feed-item post-card">
  <span aria-hidden="true" class="feed-index">{index}</span>
  <h2>
    <a
      class="story-link"
      data-astro-prefetch={externalUrl === null ? "tap" : undefined}
      href={storyUrl}
      rel={externalUrl === null ? undefined : "noreferrer noopener"}
    >
      {item.title}
      {
        item.domain !== undefined && item.domain.length > 0 && (
          <span class="faint domain"> ({item.domain})</span>
        )
      }
    </a>
  </h2>

  {
    item.type === "job" ? (
      <p class="meta">{item.time_ago}</p>
    ) : (
      <StoryMeta
        points={item.points}
        timeAgo={item.time_ago}
        commentsCount={item.comments_count}
        commentsHref={`/post/${item.id}`}
      />
    )
  }
</article>

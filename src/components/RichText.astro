---
import { Prism } from "@astrojs/prism";
import { parseHnHtml } from "~/lib/html";
import "~/styles/prism.css";

interface Props {
  readonly class?: string | undefined;
  /** Untrusted Hacker News markup. */
  readonly html: string | undefined;
}

const { class: className, html } = Astro.props;
const segments = html === undefined ? [] : parseHnHtml(html);
---

{
  segments.length > 0 && (
    <div class:list={["rich-text", className]}>
      {segments.map((segment) =>
        segment.kind === "html" ? (
          <Fragment set:html={segment.html} />
        ) : (
          <Prism
            class={segment.wrap ? "wrap" : undefined}
            code={segment.code}
            lang={segment.lang}
          />
        ),
      )}
    </div>
  )
}

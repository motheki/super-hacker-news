---
import FeedItem from "~/components/FeedItem.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { DataUnavailableError, getTopicItems } from "~/lib/data";
import { MAX_FEED_PAGE, parsePage } from "~/lib/route";
import { TOPICS } from "~/lib/topic";
import { addServerTiming } from "~/lib/timing";

const ITEMS_PER_PAGE = 30;
const topic = TOPICS.find((item) => item.name === Astro.params.topicName);
const page = parsePage(Astro.params.page);

if (topic === undefined || page === null) {
  return Astro.rewrite("/404");
}
if (Astro.params.page !== undefined && page === 1) {
  return Astro.redirect(`/${topic.name}`, 308);
}

let items: Awaited<ReturnType<typeof getTopicItems>>;
const providerStart = performance.now();
try {
  items = await getTopicItems(topic.value, page);
} catch (error) {
  if (error instanceof DataUnavailableError) {
    return Astro.rewrite("/503");
  }
  throw error;
} finally {
  addServerTiming(Astro.response.headers, "provider", performance.now() - providerStart);
}
if (items === null || (page > 1 && items.length === 0)) {
  return Astro.rewrite("/404");
}

const canonical = `/${topic.name}${page > 1 ? `/${page}` : ""}`;
const title = topic.name === "top" ? undefined : topic.title;
---

<BaseLayout canonical={canonical} title={title}>
  <section data-testid="topic-shell">
    <h1 class="visually-hidden">{topic.title}</h1>
    <div class="feed" data-testid={`topic-content-${topic.name}`}>
      {items.map((item, index) => (
        <FeedItem index={index + 1 + ITEMS_PER_PAGE * (page - 1)} item={item} />
      ))}
    </div>
    {items.length > 0 && page < MAX_FEED_PAGE && (
      <a class="more-link text-link" data-astro-prefetch="tap" href={`/${topic.name}/${page + 1}`}>
        More…
      </a>
    )}
  </section>
</BaseLayout>

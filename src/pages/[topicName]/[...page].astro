---
import FeedItem from "~/components/FeedItem.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getBuildSnapshot } from "~/lib/build-snapshot";
import { snapshotPages } from "~/lib/snapshot";
import { ITEMS_PER_PAGE, MAX_FEED_PAGE } from "~/lib/topic";
export async function getStaticPaths() { return snapshotPages(await getBuildSnapshot()); }
const { topic, page, items, hasMore, liveHasMore, liveNextPage, builtAt } = Astro.props;
const canonical = `/${topic.name}${page > 1 ? `/${page}` : ""}`;
---
<BaseLayout canonical={canonical} title={topic.name === "top" ? undefined : topic.title}>
  <section data-testid="topic-shell" data-live-feed={topic.name} data-page={page}>
    <h1 class="visually-hidden">{topic.title}</h1>
    <div class="feed-toolbar">
      <p class="meta" data-feed-status role="status">Snapshot: <time datetime={builtAt}>{builtAt}</time></p>
      <button type="button" data-refresh-feed hidden>Refresh stories</button>
    </div>
    <div class="feed" data-feed-list data-testid={`topic-content-${topic.name}`}>
      {items.map((item, index) => <FeedItem index={index + 1 + ITEMS_PER_PAGE * (page - 1)} item={item} />)}
    </div>
    {page < MAX_FEED_PAGE && (hasMore || liveHasMore) && <a class="more-link text-link" data-feed-more href={hasMore ? `/${topic.name}/${page + 1}` : `/feed?topic=${topic.name}&page=${liveNextPage}`}>{hasMore ? "More…" : "More live stories…"}</a>}
    <noscript><p><a class="text-link" href="https://news.ycombinator.com/">Browse live stories on Hacker News</a></p></noscript>
  </section>
</BaseLayout>
<script>import "~/scripts/feed";</script>

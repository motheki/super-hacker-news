---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getBuildSnapshot } from "~/lib/build-snapshot";
import { toOfficialPost } from "~/lib/hacker-news/codec";
import { searchRanges } from "~/lib/snapshot";
import { sanitizeHnHtml } from "~/lib/html";
import { isSafeExternalUrl } from "~/lib/link";
import { SITE_URL } from "~/lib/site";
export async function getStaticPaths() {
  const snapshot = await getBuildSnapshot();
  return snapshot.stories.map((item) => ({
    params: { postId: String(item.id) },
    props: { post: toOfficialPost(item, Date.parse(snapshot.builtAt) / 1000)!, builtAt: snapshot.builtAt },
  }));
}
const { post, builtAt } = Astro.props;
const ranges = searchRanges(post.time, builtAt);
const externalUrl = isSafeExternalUrl(post.url) ? post.url : null;
const content = post.content === undefined ? undefined : sanitizeHnHtml(post.content);
const canonical = `/post/${post.id}`;
const description = `${post.points} points and ${post.comments_count} comments on Hacker News.`;
const structuredData = {
  "@context": "https://schema.org", "@type": "DiscussionForumPosting",
  author: { "@type": "Person", name: post.user, url: `https://news.ycombinator.com/user?id=${encodeURIComponent(post.user)}` },
  headline: post.title, url: `${SITE_URL}${canonical}`,
};
---

<BaseLayout
  canonical={canonical}
  description={description}
  openGraphType="article"
  structuredData={structuredData}
  title={post.title}
>
  <article data-testid="post-content" data-pagefind-body>
    <h1 class="post-title" data-pagefind-meta="title">
      {
        externalUrl === null ? (
          <>
            {post.title}
            {post.domain !== undefined && post.domain.length > 0 && (
              <span class="faint domain"> ({post.domain})</span>
            )}
          </>
        ) : (
          <a class="story-link" href={externalUrl} rel="noreferrer noopener">
            {post.title}
            {post.domain !== undefined && post.domain.length > 0 && (
              <span class="faint domain"> ({post.domain})</span>
            )}
          </a>
        )
      }
    </h1>

    <p class="meta">
      {post.points} points by{" "}
      <a
        class="text-link"
        data-astro-prefetch="tap"
        href={`/user?name=${encodeURIComponent(post.user)}`}
      >
        {post.user}
      </a>{" "}
      {post.time_ago} | {post.comments_count}{" "}
      {post.comments_count === 1 ? "comment" : "comments"}
    </p>

    {
      content !== undefined && content.length > 0 && (
        <div class="post-body rich-text" set:html={content} />
      )
    }
  </article>

  <div hidden data-pagefind-body>
    <span data-pagefind-meta="user">{post.user}</span>
    <span data-pagefind-meta="domain">{post.domain ?? ""}</span>
    <span data-pagefind-meta="points">{post.points}</span>
    <span data-pagefind-meta="comments">{post.comments_count}</span>
    <span data-pagefind-sort="date" data-pagefind-meta="time">{post.time}</span>
    {ranges.map((range) => <span data-pagefind-filter="range">{range}</span>)}
  </div>
  <p class="meta">Story snapshot: <time datetime={builtAt}>{builtAt}</time>.</p>
  <section aria-label="Comments" id="comments" data-comments-id={post.id}>
    <h2>Comments</h2>
    <button data-load-comments type="button" hidden>Load comments</button>
    <p role="status" class="meta"></p>
    <div data-comments-list></div>
    <p><a class="text-link" href={`https://news.ycombinator.com/item?id=${post.id}`}>Read the discussion on Hacker News</a></p>
    <noscript><p>Live comments need JavaScript. The story above is available without it.</p></noscript>
  </section>
</BaseLayout>

<script>import "~/scripts/discussion";</script>

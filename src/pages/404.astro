---
import BaseLayout from "~/layouts/BaseLayout.astro";
---
<BaseLayout title="Not found" noindex>
  <section class="message-page">
    <h1>404 — Not found</h1>
    <p>This page is not in the current story snapshot.</p>
    <p><a class="text-link" href="/top">Return to Super HN</a> or <a class="text-link" href="https://news.ycombinator.com/">open Hacker News</a>.</p>
    <noscript><p>Older story links need JavaScript to open the live viewer.</p></noscript>
  </section>
</BaseLayout>
<script>
  import { legacyViewerUrl } from "~/lib/viewer-route";
  const target = legacyViewerUrl(new URL(location.href));
  if (target) location.replace(target);
</script>

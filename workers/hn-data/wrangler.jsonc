{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "super-hn-data",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "19e77c95-5402-4d43-93f0-0e17a4429f8b",
      "database_name": "super-hn-data",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "HYDRATE_QUEUE",
        "queue": "super-hn-hydrate",
      },
    ],
    "consumers": [
      {
        "queue": "super-hn-hydrate",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "placement": {
    "mode": "smart",
  },
}
